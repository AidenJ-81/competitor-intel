# ── 웍스AI (AI 기능: 파이프라인·챗봇·RFP분석·뉴스요약) ──────
WRKS_API_KEY=wrks_xxxxxxxxxxxxxxxx
WRKS_AGENT_ID=
# ↑ 비워두고 배포한 뒤 /api/wrks/agents 를 열면 사용 가능한 에이전트 ID가 보입니다.

# 공용 API 키 만료일. 만료 45일 전부터 /api/health 에 경고가 뜹니다.
WRKS_KEY_EXPIRES=2027-09-09
KEY_WARN_DAYS=45

# 선택 항목
# WRKS_BASE_URL=https://gateway-api.wrks.ai
# WRKS_ACTOR_EMAIL=          # System API Key일 때만 동작. 아니면 비워두세요
# WRKS_MODEL_ID=             # 비우면 에이전트 기본 모델 사용

# AI 제공자: wrks | anthropic | auto (auto = 웍스 우선, 실패 시 Anthropic 폴백)
AI_PROVIDER=wrks

# ── 네이버 뉴스 (기존과 동일) ────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── DART 오픈API (기존과 동일) ───────────────────────────────
DART_API_KEY=

# ── 선택: 웍스 장애 시 폴백용. AI_PROVIDER=auto 일 때만 사용 ──
# ANTHROPIC_API_KEY=

# ── 데이터 저장 (Coolify 볼륨을 /data 에 마운트) ─────────────
DB_PATH=/data/constructai.db
